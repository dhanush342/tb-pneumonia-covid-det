# ==========================================
# Chest X-Ray AI - AWS & Floci Configuration
# ==========================================

# Set to true to enable S3 archiving
ENABLE_S3_STORAGE=true

# S3 Bucket Name
AWS_S3_BUCKET_NAME=chest-xray-images
AWS_REGION=us-east-1

# ------------------------------------------
# Mode 1: Floci Local AWS Emulator (Free local testing)
# https://github.com/floci-io/floci
# ------------------------------------------
FLOCI_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------
# Mode 2: Real AWS Cloud Production
# Comment out FLOCI_ENDPOINT_URL and supply real AWS keys:
# ------------------------------------------
# FLOCI_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
